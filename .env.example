# API deployment profile
GRIDOS_ENV=production
GRIDOS_LOG_LEVEL=INFO
GRIDOS_APP_VERSION=2.1.0

# Comma-separated origins for browser clients
GRIDOS_CORS_ORIGINS=https://app.example.com

# SaaS auth and tenant settings
GRIDOS_REQUIRE_API_KEY=true
GRIDOS_API_KEYS=ops:replace-with-long-token,monitor:replace-with-second-token
GRIDOS_DEFAULT_TENANT_ID=public
GRIDOS_ENFORCE_TENANT_HEADER=true

# API traffic shaping
GRIDOS_ENABLE_RATE_LIMIT=true
GRIDOS_RATE_LIMIT_PER_MINUTE=240

# Backend concurrency and timeout
GRIDOS_API_WORKERS=2
GRIDOS_API_TIMEOUT_SECONDS=60

# Optional weather provider endpoint (must return `current` object)
WEATHER_API_BASE=
